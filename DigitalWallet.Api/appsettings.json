{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=wallet.db"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_USER_SECRETS_OR_ENVIRONMENT_VARIABLE",
    "Issuer": "DigitalWallet.Api",
    "Audience": "DigitalWallet.Client",
    "ExpirationMinutes": 60
  }
}